<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Microsoft/.NET packages float to the latest patch so security releases land on the next restore.
         Third-party packages stay exact and move via Dependabot. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.*" />
    <!-- Aspire.Hosting.Keycloak only ships previews, so the float must admit prereleases. -->
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.6.*-*" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.*" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.*" />
    <PackageVersion Include="Aspire.Hosting.Yarp" Version="13.6.*" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.*" />
  </ItemGroup>

  <ItemGroup Label="Microsoft">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.*" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.*" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.*" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.*" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.*" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.*" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.*" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.*" />
    <!-- Pin Microsoft.OpenApi to the latest v2: Microsoft.AspNetCore.OpenApi 10.0.9 pulls in
         2.0.0 transitively, which carries advisory GHSA-v5pm-xwqc-g5wc (fixed later in the 2.x
         line). Stay on v2 — .NET 10's OpenAPI stack targets Microsoft.OpenApi v2; v3 is a
         breaking change adopted by .NET 11. Dependabot is configured to bump only within v2. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.*" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.*" />
  </ItemGroup>

  <ItemGroup Label="Third party">
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Keycloak.Extensions" Version="13.6.1-preview.1.261026-0455" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.McpInspector" Version="13.6.1" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- ModelContextProtocol.AspNetCore requires an exact ModelContextProtocol version; keep both in lockstep. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="ReportGenerator.Core" Version="5.5.12" />
    <PackageVersion Include="Stateless" Version="5.20.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Vogen" Version="8.0.7" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
